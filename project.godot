; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="UIRPG"
config/description="A deckbuilder of physical cards. Build in the Library, craft on the Bench, descend the Stacks."
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="RazeahUIRPG"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false

[audio]

buses/default_bus_layout=""

[autoload]

Content="*res://src/application/content.gd"
Session="*res://src/application/session.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=960
window/size/min_height=720

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0313726, 0.0666667, 0.0588235, 1)
